DB_PORT=3306
DB_NAME=keystonedb
DB_USERNAME=keystone_user
DB_PASSWORD=replace_with_a_very_strong_password_for_mysql_user
DB_ROOT_PASSWORD=replace_with_a_very_strong_password_for_mysql_root

# Spring Security & JWT Token Configuration (256-bit+ Base64 Secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated exact domains)
